{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "customConditions": [
      "development"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "*.config.ts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.next/**"
  ]
}
