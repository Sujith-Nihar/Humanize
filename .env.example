DATABASE_URL=postgres://humanize:local-development-only@127.0.0.1:54329/humanize
HUMANIZE_TEST_DATABASE_URL=postgres://humanize:local-development-only@127.0.0.1:54329/humanize_test
HUMANIZE_PORT=3001
HUMANIZE_CONTROL_PLANE_URL=http://127.0.0.1:3001
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Supply secrets through deployment management. Never commit populated values.

# Required by the API and the worker.
# GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY, GITHUB_WEBHOOK_SECRET

# Provider credential encryption (spec 26.3). Comma-separated version:base64 pairs, each key
# 32 bytes (openssl rand -base64 32). Several may be present during rotation; the active one
# encrypts and every listed one can still decrypt what it wrote.
# HUMANIZE_ENCRYPTION_KEYS=v1:<base64>
# HUMANIZE_ENCRYPTION_ACTIVE_KEY=v1   (optional when only one key is listed)

# Administration (API). All four of these plus HUMANIZE_ENCRYPTION_KEYS are required, or the
# administration routes are not registered and the API says which are missing.
# HUMANIZE_SESSION_KEY=<base64, at least 32 bytes>
# GITHUB_OAUTH_CLIENT_ID, GITHUB_OAUTH_CLIENT_SECRET   (the GitHub App's own OAuth credentials)
# HUMANIZE_OAUTH_REDIRECT_URL=https://<host>/auth/github/callback   (optional)

# Cloud execution (worker). Needs HUMANIZE_ENCRYPTION_KEYS and the App credentials above.
# HUMANIZE_BEDROCK_REGION=us-east-1   (required when policy names Bedrock)
# HUMANIZE_CLOUD_OLLAMA_BASE_URL      (only for a deployment that operates its own local model;
#                                      never a customer-supplied URL, spec 26.4)
